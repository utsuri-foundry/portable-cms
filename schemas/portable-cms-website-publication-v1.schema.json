{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utsuri.io/schemas/portable-cms-website-publication-v1.schema.json",
  "title": "Website publication intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "profileId", "revision", "mode", "websiteName", "iconMediaId", "translations"],
  "properties": {
    "administrationBranding": {
      "type": "object", "additionalProperties": false,
      "required": ["logoMediaId", "darkLogoMediaId"],
      "properties": {
        "logoMediaId": {"type": ["string", "null"], "pattern": "^[a-f0-9]{32}$"},
        "darkLogoMediaId": {"type": ["string", "null"], "pattern": "^[a-f0-9]{32}$"}
      }
    },
    "identityUpgrade": {
      "type": "object", "additionalProperties": false, "required": ["kept", "previous"],
      "properties": {
        "kept": { "enum": ["website-settings", "profile-settings"] },
        "previous": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["typeId", "recordId", "name", "iconMediaId"],
            "properties": {
              "typeId": { "type": "string", "maxLength": 160, "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$" },
              "recordId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
              "name": { "type": ["string", "null"], "minLength": 1, "maxLength": 180 },
              "iconMediaId": { "type": ["string", "null"], "pattern": "^[a-f0-9]{32}$" }
            }
          }
        }
      }
    },
    "formatVersion": {"const": 1},
    "profileId": {"type": "string", "maxLength": 160, "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 4294967294},
    "mode": {"enum": ["coming_soon", "live"]},
    "websiteName": {"type": "string", "minLength": 1, "maxLength": 180},
    "iconMediaId": {"type": ["string", "null"], "pattern": "^[a-f0-9]{32}$"},
    "translations": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["locale", "message", "contact"],
        "properties": {
          "locale": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"},
          "message": {"type": "string", "minLength": 1, "maxLength": 600},
          "contact": {"type": "string", "maxLength": 240}
        }
      }
    }
  }
}
