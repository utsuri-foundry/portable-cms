{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utsuri.io/portable-cms/rich-text-v2.schema.json",
  "title": "Portable CMS bounded rich text v2 with small capitals",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "nodes"],
  "properties": {
    "formatVersion": { "const": 2 },
    "nodes": { "type": "array", "maxItems": 5000, "items": { "oneOf": [ { "$ref": "#/$defs/textBlock" }, { "$ref": "#/$defs/list" } ] } }
  },
  "$defs": {
    "runs": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/run" } },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["text", "marks"],
      "properties": {
        "text": { "type": "string", "maxLength": 10000 },
        "marks": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "oneOf": [ { "enum": ["bold", "italic", "underline", "smallCaps"] }, { "$ref": "#/$defs/link" } ] } }
      }
    },
    "link": {
      "type": "object", "additionalProperties": false, "required": ["type", "href"],
      "properties": { "type": { "const": "link" }, "href": { "type": "string", "minLength": 1, "maxLength": 2048 } }
    },
    "textBlock": {
      "type": "object", "additionalProperties": false, "required": ["type", "children"],
      "properties": { "type": { "enum": ["paragraph", "heading_2", "heading_3"] }, "children": { "$ref": "#/$defs/runs" } }
    },
    "listItem": {
      "type": "object", "additionalProperties": false, "required": ["type", "children"],
      "properties": { "type": { "const": "list_item" }, "children": { "$ref": "#/$defs/runs" } }
    },
    "list": {
      "type": "object", "additionalProperties": false, "required": ["type", "children"],
      "properties": { "type": { "enum": ["bullet_list", "ordered_list"] }, "children": { "type": "array", "minItems": 1, "maxItems": 5000, "items": { "$ref": "#/$defs/listItem" } } }
    }
  }
}
