{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utsuri.io/portable-cms/search-v1.schema.json",
  "title": "Portable CMS static search index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "locale", "normalization", "ordering", "documents", "terms"],
  "properties": {
    "formatVersion": { "const": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
    "normalization": { "const": "unicode_nfkd_accent_fold_lower_words_v1" },
    "ordering": { "const": "weight_desc_document_id_asc" },
    "documents": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/document" }
    },
    "terms": {
      "type": "array",
      "maxItems": 200000,
      "items": { "$ref": "#/$defs/term" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "canonicalId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^/(?:[A-Za-z0-9._~-]+/)*$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "typeId", "route", "title", "resultKind", "mediaId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "typeId": { "$ref": "#/$defs/canonicalId" },
        "route": { "$ref": "#/$defs/route" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "resultKind": { "enum": ["image", "text"] },
        "mediaId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "posting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "weight"],
      "properties": {
        "documentId": { "$ref": "#/$defs/id" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "postings"],
      "properties": {
        "token": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[\\p{L}\\p{N}]+$" },
        "postings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/posting" }
        }
      }
    }
  }
}
