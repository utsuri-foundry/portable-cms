{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.utsuri.io/portable-cms/feed-snapshot-v1.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "snapshotId",
        "formatVersion",
        "profileId",
        "locales",
        "collections",
        "records",
        "media"
    ],
    "properties": {
        "snapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "formatVersion": {
            "const": 1
        },
        "profileId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "maxLength": 160
        },
        "locales": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
                "maxLength": 7
            }
        },
        "collections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "typeId",
                    "locale",
                    "recordCount",
                    "pages"
                ],
                "properties": {
                    "typeId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
                        "maxLength": 160
                    },
                    "locale": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
                        "maxLength": 7
                    },
                    "recordCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3200
                    },
                    "pages": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3200,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "path",
                                "byteSize",
                                "sha256"
                            ],
                            "properties": {
                                "path": {
                                    "type": "string",
                                    "pattern": "^[A-Za-z0-9][A-Za-z0-9/_-]*(?:\\.[a-z0-9]+)?$",
                                    "maxLength": 500
                                },
                                "byteSize": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 8388608
                                },
                                "sha256": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{64}$"
                                }
                            }
                        }
                    }
                }
            }
        },
        "records": {
            "type": "array",
            "minItems": 0,
            "maxItems": 51200,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "typeId",
                    "locale",
                    "id",
                    "revisionNumber",
                    "sha256"
                ],
                "properties": {
                    "typeId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
                        "maxLength": 160
                    },
                    "locale": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
                        "maxLength": 7
                    },
                    "id": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{32}$"
                    },
                    "revisionNumber": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4294967294
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                    }
                }
            }
        },
        "media": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "path",
                    "mime",
                    "byteSize",
                    "sha256"
                ],
                "properties": {
                    "path": {
                        "type": "string",
                        "pattern": "^feed/v1/media/[a-f0-9]{64}\\.webp$",
                        "maxLength": 500
                    },
                    "mime": {
                        "const": "image/webp"
                    },
                    "byteSize": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10485760
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                    }
                }
            }
        }
    }
}
