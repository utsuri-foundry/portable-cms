{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utsuri.io/portable-cms/snapshot-v1.schema.json",
  "title": "Portable CMS frozen compiler snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "snapshotId", "createdAt", "profile", "records", "media"],
  "properties": {
    "websiteIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "iconMediaId"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "iconMediaId": { "type": ["string", "null"], "pattern": "^[a-f0-9]{32}$" }
      }
    },
    "includeDrafts": { "type": "boolean", "default": false },
    "preparationLocales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" }
    },
    "wording": {
      "description": "The site wording in the snapshot's languages. Without it, the profile's defaults apply.",
      "type": "array",
      "maxItems": 3200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "locale", "text"],
        "properties": {
          "key": { "type": "string", "maxLength": 100, "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$" },
          "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "formatVersion": { "const": 1 },
    "publishedSlugHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "profileId",
        "releaseId",
        "artifactSha256",
        "activatedAt",
        "verificationId",
        "publicUrlContext",
        "routes",
        "previousPaths"
      ],
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "profileId": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
        },
        "releaseId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 32
        },
        "verificationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "publicUrlContext": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "formatVersion",
            "baseUrl"
          ],
          "properties": {
            "formatVersion": {
              "const": 1
            },
            "baseUrl": {
              "type": "string",
              "minLength": 9,
              "maxLength": 1000,
              "pattern": "^https://[^\\s]+$"
            }
          }
        },
        "routes": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "locale",
              "translationGroup"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^/(?:[A-Za-z0-9._~-]+/)*$"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
              },
              "translationGroup": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9:_-]{0,159}$"
              }
            }
          }
        },
        "previousPaths": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "locale",
              "translationGroup"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^/(?:[A-Za-z0-9._~-]+/)*$"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
              },
              "translationGroup": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9:_-]{0,159}$"
              }
            }
          }
        }
      }
    },
    "publicUrlContext": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "baseUrl"],
      "properties": {
        "formatVersion": { "const": 1 },
        "baseUrl": { "type": "string", "minLength": 9, "maxLength": 1000, "pattern": "^https://[^\\s]+$" }
      }
    },
    "snapshotId": { "$ref": "#/$defs/id" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "profile": { "$ref": "#/$defs/profile" },
    "records": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/record" }
    },
    "media": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/media" }
    },
