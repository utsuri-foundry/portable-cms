{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utsuri.io/portable-cms/artifact-v1.schema.json",
  "title": "Portable CMS static artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "releaseId",
    "snapshotId",
    "createdAt",
    "profile",
    "compiler",
    "searchFormatVersion",
    "files",
    "redirects",
    "publicMedia"
  ],
  "properties": {
    "frameSources": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": "https://player.vimeo.com" } },
    "contentFeed": {"type":"object","additionalProperties":false,"required":["snapshotId","formatVersion","profileId","locales","collections","records","media"],"properties":{"snapshotId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"formatVersion":{"const":1},"profileId":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$","maxLength":160},"locales":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"string","pattern":"^[a-z]{2,3}(?:-[A-Z]{2})?$","maxLength":7}},"collections":{"type":"array","minItems":1,"maxItems":1024,"items":{"type":"object","additionalProperties":false,"required":["typeId","locale","recordCount","pages"],"properties":{"typeId":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$","maxLength":160},"locale":{"type":"string","pattern":"^[a-z]{2,3}(?:-[A-Z]{2})?$","maxLength":7},"recordCount":{"type":"integer","minimum":0,"maximum":3200},"pages":{"type":"array","minItems":1,"maxItems":3200,"items":{"type":"object","additionalProperties":false,"required":["path","byteSize","sha256"],"properties":{"path":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9/_-]*(?:\\.[a-z0-9]+)?$","maxLength":500},"byteSize":{"type":"integer","minimum":1,"maximum":8388608},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}}},"records":{"type":"array","minItems":0,"maxItems":51200,"items":{"type":"object","additionalProperties":false,"required":["typeId","locale","id","revisionNumber","sha256"],"properties":{"typeId":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$","maxLength":160},"locale":{"type":"string","pattern":"^[a-z]{2,3}(?:-[A-Z]{2})?$","maxLength":7},"id":{"type":"string","pattern":"^[a-f0-9]{32}$"},"revisionNumber":{"type":"integer","minimum":1,"maximum":4294967294},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},"media":{"type":"array","minItems":0,"maxItems":5000,"items":{"type":"object","additionalProperties":false,"required":["path","mime","byteSize","sha256"],"properties":{"path":{"type":"string","pattern":"^feed/v1/media/[a-f0-9]{64}\\.webp$","maxLength":500},"mime":{"const":"image/webp"},"byteSize":{"type":"integer","minimum":1,"maximum":10485760},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}},
    "publicationMode": {"enum": ["coming_soon", "live"]},
    "websitePublication": {
      "type": "object", "additionalProperties": false, "required": ["revision", "sha256"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0, "maximum": 4294967294},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "includeDrafts": { "type": "boolean", "default": false },
    "preparationLocales": {
      "type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"}
    },
    "routeIdentities": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "locale",
          "translationGroup"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^/(?:[A-Za-z0-9._~-]+/)*$"
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
          },
          "translationGroup": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:_-]{0,159}$"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "target",
        "path",
        "sha256"
      ],
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "target": {
          "const": "apache24"
        },
        "path": {
          "const": "delivery/apache24.conf"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "formatVersion": {
      "const": 1
    },
    "publicUrlContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "baseUrl",
        "sha256"
      ],
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "baseUrl": {
          "type": "string",
          "minLength": 9,
          "maxLength": 1000,
          "pattern": "^https://[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "releaseId": {
      "$ref": "#/$defs/id"
    },
    "snapshotId": {
      "$ref": "#/$defs/id"
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "profile": {
      "$ref": "#/$defs/component"
    },
    "compiler": {
      "$ref": "#/$defs/component"
    },
    "searchFormatVersion": {
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "redirects": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/redirect"
      }
    },
    "publicMedia": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/publicMedia"
      }
    },
    "designRegistries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "sha256"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sharingImages": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/sharingImage"
      }
    },
    "websiteIcon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaId",
        "sourceSha256",
        "recipe",
        "files"
      ],
      "properties": {
        "mediaId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "processorVersion"
          ],
          "properties": {
            "id": {
              "const": "imagick-website-icon-png"
            },
            "version": {
              "const": 1
            },
            "processorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "size",
              "path",
              "sha256",
              "byteSize"
            ],
            "properties": {
              "size": {
                "enum": [
                  32,
                  180,
                  512
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^icons/[a-f0-9]{64}\\.png$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10485760
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "canonicalId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9/_.-]*$"
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^/(?:[A-Za-z0-9._~-]+/)*$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonicalId"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mime",
        "byteSize",
        "sha256",
        "cachePolicy"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "mime": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+(?:; charset=utf-8)?$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cachePolicy": {
          "enum": [
            "route",
            "immutable",
            "no_store"
          ]
        }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "status"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/route"
        },
        "to": {
          "$ref": "#/$defs/route"
        },
        "status": {
          "enum": [
            301,
            308
          ]
        }
      }
    },
    "publicMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaId",
        "variant",
        "path",
        "sha256"
      ],
      "properties": {
        "mediaId": {
          "$ref": "#/$defs/id"
        },
        "variant": {
          "$ref": "#/$defs/canonicalId"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sharingImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaId",
        "sourceSha256",
        "path",
        "sha256",
        "byteSize",
        "width",
        "height",
        "recipe"
      ],
      "properties": {
        "mediaId": {
          "$ref": "#/$defs/id"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "type": "string",
          "pattern": "^sharing/[a-f0-9]{64}\\.jpg$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "width": {
          "const": 1200
        },
        "height": {
          "const": 630
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "processorVersion",
            "quality",
            "fit",
            "background"
          ],
          "properties": {
            "id": {
              "const": "imagick-sharing-jpeg"
            },
            "version": {
              "const": 1
            },
            "processorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "quality": {
              "const": 82
            },
            "fit": {
              "const": "contain-no-upscale"
            },
            "background": {
              "const": "white"
            }
          }
        }
      }
    }
  }
}
