{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utsuri.io/portable-cms/structured-data-v1.schema.json",
  "title": "Portable CMS trusted structured-data output v1",
  "type": "object", "additionalProperties": false,
  "required": ["@context", "@graph"],
  "properties": {
    "@context": { "const": "https://schema.org" },
    "@graph": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "oneOf": [
      { "$ref": "#/$defs/organization" }, { "$ref": "#/$defs/article" }, { "$ref": "#/$defs/breadcrumbs" }
    ] } }
  },
  "$defs": {
    "url": { "type": "string", "maxLength": 1500, "pattern": "^https://[^\\s]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "organization": {
      "type": "object", "additionalProperties": false, "required": ["@type", "name", "url"],
      "properties": { "@type": { "const": "Organization" }, "name": { "type": "string", "minLength": 1, "maxLength": 160 }, "url": { "$ref": "#/$defs/url" } }
    },
    "article": {
      "type": "object", "additionalProperties": false, "required": ["@type", "headline", "inLanguage", "url"],
      "properties": {
        "@type": { "const": "Article" }, "headline": { "$ref": "#/$defs/title" },
        "inLanguage": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
        "url": { "$ref": "#/$defs/url" }, "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "breadcrumbs": {
      "type": "object", "additionalProperties": false, "required": ["@type", "itemListElement"],
      "properties": {
        "@type": { "const": "BreadcrumbList" },
        "itemListElement": { "type": "array", "minItems": 2, "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["@type", "position", "name", "item"],
          "properties": { "@type": { "const": "ListItem" }, "position": { "type": "integer", "minimum": 1, "maximum": 8 }, "name": { "$ref": "#/$defs/title" }, "item": { "$ref": "#/$defs/url" } }
        } }
      }
    }
  }
}
