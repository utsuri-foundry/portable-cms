{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:utsuri:portable-cms:composition:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "rows"],
  "properties": {
    "formatVersion": {"const": 1},
    "columnGap": {"$ref": "#/$defs/length"},
    "rowGap": {"$ref": "#/$defs/length"},
    "padding": {"$ref": "#/$defs/length"},
    "stackAt": {"type": ["string", "null"], "maxLength": 80},
    "rows": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
    "length": {
      "type": "object", "additionalProperties": false, "required": ["unit", "value"],
      "properties": {
        "unit": {"enum": ["px", "rem", "vw", "vh", "token"]},
        "value": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 4000}, {"$ref": "#/$defs/identity"}]}
      }
    },
    "source": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"const": "media"}, "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "field"], "properties": {"kind": {"enum": ["rich_text", "video", "block"]}, "field": {"$ref": "#/$defs/identity"}}}
      ]
    },
    "column": {
      "type": "object", "additionalProperties": false, "required": ["share", "content"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"}, "share": {"type": "number", "minimum": 0.01, "maximum": 1000},
        "content": {"$ref": "#/$defs/source"}, "width": {"type": "number", "minimum": 1, "maximum": 100},
        "anchor": {"enum": ["top-left", "top-center", "top-right", "mid-left", "mid-center", "mid-right", "bottom-left", "bottom-center", "bottom-right"]},
        "roleId": {"type": ["string", "null"], "maxLength": 80},
        "padding": {"type": "object", "additionalProperties": false, "properties": {"top": {"$ref": "#/$defs/length"}, "right": {"$ref": "#/$defs/length"}, "bottom": {"$ref": "#/$defs/length"}, "left": {"$ref": "#/$defs/length"}}}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false, "required": ["id", "columns"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"}, "gap": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/length"}]},
        "minHeight": {"$ref": "#/$defs/length"},
        "columns": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/column"}}
      }
    }
  }
}
