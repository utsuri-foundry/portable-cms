{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.utsuri.io/portable-cms/feed-v1.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "formatVersion",
        "sequence",
        "releaseId",
        "activation",
        "snapshotId",
        "fullRead",
        "activations",
        "cursorFloor",
        "missingFile",
        "status"
    ],
    "properties": {
        "formatVersion": {
            "const": 1
        },
        "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "releaseId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
        },
        "activation": {
            "type": "string",
            "pattern": "^feed/v1/activations/[1-9][0-9]*-[a-f0-9]{32}\\.json$",
            "maxLength": 500
        },
        "snapshotId": {
            "anyOf": [
                {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                {
                    "type": "null"
                }
            ]
        },
        "fullRead": {
            "anyOf": [
                {
                    "type": "string",
                    "pattern": "^feed/v1/snapshots/[a-f0-9]{64}/manifest\\.json$",
                    "maxLength": 500
                },
                {
                    "type": "null"
                }
            ]
        },
        "activations": {
            "const": "feed/v1/activations.json"
        },
        "cursorFloor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "missingFile": {
            "const": "read-current-pointer-and-restart-full-read"
        },
        "status": {
            "enum": [
                "available",
                "disabled",
                "purged"
            ]
        }
    }
}
