  "$defs": {
    "vimeoVideo": {"type":"object","additionalProperties":false,"required":["formatVersion","videoId","privacyHash","poster","title"],"properties":{"formatVersion":{"const":1},"videoId":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"},"privacyHash":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[A-Za-z0-9]{10}$"}]},"poster":{"type":"string","pattern":"^[a-f0-9]{32}$"},"title":{"type":"string","minLength":1,"maxLength":200,"pattern":"^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$"}}},
    "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "canonicalId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "packageSha256", "defaultLocale", "locales"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "defaultLocale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
        "locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "typeId", "workflowState", "revisionId", "revisionNumber", "body", "relationships"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "typeId": { "$ref": "#/$defs/canonicalId" },
        "workflowState": { "enum": ["draft", "published", "archived"] },
        "revisionId": { "$ref": "#/$defs/id" },
        "revisionNumber": { "type": "integer", "minimum": 1 },
        "body": { "type": "object", "maxProperties": 64 },
        "relationships": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fieldId", "kind", "targetRecordId", "position"],
            "properties": {
              "fieldId": { "type": "string", "maxLength": 160, "pattern": "^[a-z][A-Za-z0-9]*(?:[-_][a-z0-9]+)*$" },
              "kind": { "enum": ["record", "taxonomy"] },
              "targetRecordId": { "$ref": "#/$defs/id" },
              "targetTypeId": { "$ref": "#/$defs/canonicalId" },
              "position": { "type": "integer", "minimum": 0, "maximum": 65535 }
            }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerRecordId", "variant", "mime", "byteSize", "sha256", "width", "height"],
      "dependentRequired": {"durationMilliseconds": ["hasAudio"], "hasAudio": ["durationMilliseconds"]},
      "properties": {
        "durationMilliseconds": {"type": "integer", "minimum": 1, "maximum": 7200000},
        "hasAudio": {"type": "boolean"},
        "focalPoint": {
          "type": "object", "additionalProperties": false, "required": ["x", "y"],
          "properties": {"x": {"type": "integer", "minimum": 0, "maximum": 100}, "y": {"type": "integer", "minimum": 0, "maximum": 100}}
        },
        "text": { "$ref": "#/$defs/mediaText" },
        "widths": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/imageWidth" } },
        "id": { "$ref": "#/$defs/id" },
        "ownerRecordId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "variant": { "$ref": "#/$defs/canonicalId" },
        "mime": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
        "byteSize": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "height": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
      }
    },
    "imageWidth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "mime", "byteSize", "sha256", "width", "height"],
      "properties": {
        "variant": { "enum": ["display_480_webp", "display_960_webp", "display_1600_webp", "display_2400_webp"] },
        "mime": { "const": "image/webp" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 41943040 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1, "maximum": 2400 },
        "height": { "type": "integer", "minimum": 1, "maximum": 20000 }
      }
    },
    "mediaText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "decorative",
        "translations"
      ],
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "decorative": {
          "type": "boolean"
        },
        "translations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locale",
              "alternativeText",
              "caption",
              "credit"
            ],
            "properties": {
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
              },
              "alternativeText": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^[^\\x00-\\x1f\\x7f<>]*$"
              },
              "caption": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^[^\\x00-\\x1f\\x7f<>]*$"
              },
              "credit": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^[^\\x00-\\x1f\\x7f<>]*$"
              }
            }
          }
        }
      }
    }
  }
}
