  "$defs": {
    "canonicalId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "fieldId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][A-Za-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "localeId": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9/_.-]*$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "contracts"],
      "properties": {
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximumExclusive"],
          "properties": {
            "minimum": { "$ref": "#/$defs/semanticVersion" },
            "maximumExclusive": { "$ref": "#/$defs/semanticVersion" }
          }
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["record", "protocol", "snapshot", "artifact", "search", "export", "capabilities"],
          "properties": {
            "record": { "const": 1 },
            "protocol": { "const": 1 },
            "snapshot": { "const": 1 },
            "artifact": { "const": 1 },
            "search": { "const": 1 },
            "export": { "const": 1 },
            "capabilities": { "const": 1 }
          }
        }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/localeId" },
        "label": { "$ref": "#/$defs/label" }
      }
    },
    "recordType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "singularLabel", "archetype", "renderer", "routePrefix", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "label": { "$ref": "#/$defs/label" },
        "singularLabel": { "$ref": "#/$defs/label" },
        "archetype": { "enum": ["portfolio_entry", "article", "person", "organisation"] },
        "renderer": { "$ref": "#/$defs/canonicalId" },
        "routePrefix": { "$ref": "#/$defs/canonicalId" },
        "fields": { "$ref": "#/$defs/fields" }
      }
    },
    "singleton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "singularLabel", "archetype", "renderer", "routePath", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "label": { "$ref": "#/$defs/label" },
        "singularLabel": { "$ref": "#/$defs/label" },
        "archetype": { "enum": ["page", "site_settings"] },
        "renderer": { "$ref": "#/$defs/canonicalId" },
        "routePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*/?)*$"
        },
        "fields": { "$ref": "#/$defs/fields" }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "singularLabel", "archetype", "renderer", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "label": { "$ref": "#/$defs/label" },
        "singularLabel": { "$ref": "#/$defs/label" },
        "archetype": { "const": "taxonomy_term" },
        "renderer": { "$ref": "#/$defs/canonicalId" },
        "fields": { "$ref": "#/$defs/fields" }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/field" }
    },
    "leafFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/leafField" }
    },
    "fieldBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "localized", "requiredOnDraft", "requiredOnPublish", "settings"],
      "properties": {
        "id": { "$ref": "#/$defs/fieldId" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "$ref": "#/$defs/fieldType" },
        "localized": { "type": "boolean" },
        "requiredOnDraft": { "type": "boolean" },
        "requiredOnPublish": { "type": "boolean" },
        "hint": {"type":"string","minLength":1,"maxLength":160,"pattern":"^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$"},
        "editorialSection": { "enum": ["details", "content", "media", "relationships", "layout", "discovery"] },
        "settings": { "type": "object" }
      }
    },
    "fieldType": {
      "enum": [
        "short_text", "multiline_text", "integer", "decimal", "boolean", "date", "enum",
        "rich_text", "web_address", "vimeo_video", "media_references", "video_reference", "record_reference", "record_references",
        "taxonomy_references", "group", "repeatable_group", "composition", "blocks"
      ]
    },
    "leafFieldType": {
      "enum": [
        "short_text", "multiline_text", "integer", "decimal", "boolean", "date", "enum",
        "rich_text", "web_address", "vimeo_video", "media_references", "video_reference", "record_reference", "record_references",
        "taxonomy_references", "composition"
      ]
    },
    "field": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        { "$ref": "#/$defs/fieldSettings" }
      ]
    },
    "leafField": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "type", "localized", "requiredOnDraft", "requiredOnPublish", "settings"],
          "properties": {
            "id": { "$ref": "#/$defs/fieldId" },
            "label": { "$ref": "#/$defs/label" },
            "type": { "$ref": "#/$defs/leafFieldType" },
            "localized": { "type": "boolean" },
            "requiredOnDraft": { "type": "boolean" },
            "requiredOnPublish": { "type": "boolean" },
            "hint": {"type":"string","minLength":1,"maxLength":160,"pattern":"^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$"},
        "editorialSection": { "enum": ["details", "content", "media", "relationships", "layout", "discovery"] },
            "settings": { "type": "object" }
          }
        },
        { "$ref": "#/$defs/fieldSettings" }
      ]
    },
    "fieldSettings": {
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["short_text", "multiline_text"] } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/textSettings" } } } },
        { "if": { "properties": { "type": { "const": "web_address" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/webAddressSettings" } } } },
        { "if": { "properties": { "type": { "const": "vimeo_video" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/vimeoVideoSettings" } } } },
        { "if": { "properties": { "type": { "const": "integer" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/integerSettings" } } } },
        { "if": { "properties": { "type": { "const": "decimal" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/decimalSettings" } } } },
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/booleanSettings" } } } },
        { "if": { "properties": { "type": { "const": "date" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/dateSettings" } } } },
        { "if": { "properties": { "type": { "const": "enum" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/enumSettings" } } } },
        { "if": { "properties": { "type": { "const": "rich_text" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/richTextSettings" } } } },
        { "if": { "properties": { "type": { "const": "media_references" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/mediaSettings" } } } },
        { "if": { "properties": { "type": { "const": "video_reference" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/videoSettings" } } } },
        { "if": { "properties": { "type": { "const": "record_reference" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/singleReferenceSettings" } } } },
        { "if": { "properties": { "type": { "const": "record_references" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/multipleReferenceSettings" } } } },
        { "if": { "properties": { "type": { "const": "taxonomy_references" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/taxonomyReferenceSettings" } } } },
        { "if": { "properties": { "type": { "const": "blocks" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/blocksSettings" } } } },
        { "if": { "properties": { "type": { "const": "group" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/groupSettings" } } } },
        { "if": { "properties": { "type": { "const": "repeatable_group" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/repeatableGroupSettings" } } } },
        { "if": { "properties": { "type": { "const": "composition" } } }, "then": { "properties": { "settings": { "$ref": "#/$defs/compositionSettings" } } } }
      ]
    },
    "textSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumLength"],
      "properties": {
        "maximumLength": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "default": { "type": "string", "maxLength": 20000 }
      }
    },
    "vimeoVideoSettings": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "webAddressSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumLength"],
      "properties": {
        "maximumLength": { "type": "integer", "minimum": 1, "maximum": 2048 }
      }
    },
    "integerSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "maximum": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "default": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "decimalSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "scale"],
      "properties": {
        "minimum": { "type": "string", "pattern": "^-?[0-9]{1,12}(?:\\.[0-9]{1,6})?$" },
        "maximum": { "type": "string", "pattern": "^-?[0-9]{1,12}(?:\\.[0-9]{1,6})?$" },
        "scale": { "type": "integer", "minimum": 0, "maximum": 6 },
        "default": { "type": "string", "pattern": "^-?[0-9]{1,12}(?:\\.[0-9]{1,6})?$" }
      }
    },
    "booleanSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "default": { "type": "boolean" } }
    },
    "dateSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "default": { "type": "string", "format": "date" } }
    },
    "enumSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "$ref": "#/$defs/canonicalId" },
              "label": { "$ref": "#/$defs/label" }
            }
          }
        },
        "default": { "$ref": "#/$defs/canonicalId" }
      }
    },
    "richTextSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumNodes", "blocks", "marks"],
      "properties": {
        "maximumNodes": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maximumBlocks": { "const": 1 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["paragraph", "heading_2", "heading_3", "bullet_list", "ordered_list"] }
        },
        "marks": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["bold", "italic", "underline", "smallCaps", "link"] }
        }
      }
    },
    "mediaSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumItems", "kinds"],
      "properties": {
        "purpose": { "const": "website-icon" },
        "maximumItems": { "type": "integer", "minimum": 1, "maximum": 64 },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["image", "document"] }
        }
      }
    },
    "videoSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posterRequired", "maximumBytes"],
      "properties": {
        "posterRequired": { "const": true },
        "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "maximumDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "maximumWidth": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maximumHeight": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "sound": { "enum": ["allowed", "none"] }
      }
    },
    "singleReferenceSettings": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{ "required": ["targetType"] }, { "required": ["targetTypes"] }],
      "properties": {
        "targetType": { "$ref": "#/$defs/canonicalId" },
        "targetTypes": { "$ref": "#/$defs/targetTypes" }
      }
    },
    "multipleReferenceSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumItems"],
      "oneOf": [{ "required": ["targetType"] }, { "required": ["targetTypes"] }],
      "properties": {
        "targetType": { "$ref": "#/$defs/canonicalId" },
        "targetTypes": { "$ref": "#/$defs/targetTypes" },
        "maximumItems": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "targetTypes": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "$ref": "#/$defs/canonicalId" }
    },
    "taxonomyReferenceSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetType", "maximumItems"],
      "properties": {
        "targetType": { "$ref": "#/$defs/canonicalId" },
        "maximumItems": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "blocksSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumItems",
        "maximumItems",
        "blockTypes"
      ],
      "properties": {
        "minimumItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "maximumItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "blockTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/blockType"
          }
        }
      }
    },
    "blockType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonicalId"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "itemLabel": {
          "$ref": "#/$defs/label"
        },
        "fields": {
          "$ref": "#/$defs/leafFields"
        }
      }
    },
    "groupSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": { "$ref": "#/$defs/leafFields" },
        "searchSharing": {
          "type": "object", "additionalProperties": false,
          "required": ["settingsType", "titleFormatField"],
          "oneOf": [{ "required": ["siteNameField"] }, { "required": ["siteNameSource"] }],
          "dependentRequired": { "indexing": ["pagePath"] },
          "properties": {
            "settingsType": { "$ref": "#/$defs/canonicalId" },
            "siteNameField": { "$ref": "#/$defs/fieldId" },
            "siteNameSource": { "const": "website-settings" },
            "titleFormatField": { "$ref": "#/$defs/fieldId" },
            "defaultImageField": { "$ref": "#/$defs/fieldId" },
            "defaultDescriptionField": { "$ref": "#/$defs/fieldId" },
            "indexing": { "const": "excluded" },
            "pagePath": { "type": "string", "maxLength": 500, "pattern": "^/(?:[A-Za-z0-9][A-Za-z0-9._~-]*/)+$" },
            "coverImageField": { "$ref": "#/$defs/fieldId" },
            "coverFallbackField": { "$ref": "#/$defs/fieldId" },
            "titleField": { "$ref": "#/$defs/fieldId" },
            "descriptionField": { "$ref": "#/$defs/fieldId" },
            "titleFallback": {
              "type": "object", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 240 },
              "maxProperties": 16, "propertyNames": { "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" }
            }
          }
        }
      }
    },
    "repeatableGroupSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumItems", "fields"],
      "properties": {
        "maximumItems": { "type": "integer", "minimum": 1, "maximum": 64 },
        "fields": { "$ref": "#/$defs/leafFields" },
        "presentation": { "enum": ["rows", "cards"] },
        "itemLabel": { "$ref": "#/$defs/label" }
      }
    },
    "compositionSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "maximumRows", "maximumColumns"],
      "dependentSchemas": { "targetTypes": { "properties": { "formatVersion": { "const": 2 } } } },
      "properties": {
        "formatVersion": { "enum": [1, 2] },
        "targetTypes": { "$ref": "#/$defs/targetTypes" },
        "maximumRows": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maximumColumns": { "type": "integer", "minimum": 1, "maximum": 12 },
        "stackAt": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$" },
        "defaultRole": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$" },
        "videoEnabled": { "type": "boolean" },
        "blockFields": { "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "$ref": "#/$defs/fieldId" } },
        "columnGap": { "$ref": "#/$defs/compositionLength" },
        "rowGap": { "$ref": "#/$defs/compositionLength" }
      }
    },
    "compositionLength": {
      "type": "object", "additionalProperties": false, "required": ["unit", "value"],
      "properties": {
        "unit": { "enum": ["px", "rem", "vw", "vh", "token"] },
        "value": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 4000 }, { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$" }] }
      }
    },
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "targetKind", "targetId", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "label": { "$ref": "#/$defs/label" },
        "targetKind": { "enum": ["collection", "singleton", "taxonomy", "system"] },
        "targetId": { "$ref": "#/$defs/canonicalId" },
        "position": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "wordingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "purpose", "kind", "maximumLength", "defaults"],
      "properties": {
        "key": { "type": "string", "maxLength": 100, "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$" },
        "label": { "$ref": "#/$defs/label" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
        "kind": { "enum": ["text", "address_segment"] },
        "maximumLength": { "type": "integer", "minimum": 1, "maximum": 500 },
        "uniqueIn": { "$ref": "#/$defs/canonicalId" },
        "defaults": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/$defs/localeId" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "entrypoint"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "kind": { "enum": ["record", "index", "singleton", "taxonomy", "search", "feed"] },
        "entrypoint": { "allOf": [{ "$ref": "#/$defs/safePath" }, { "pattern": "\\.php$" }] }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "mime", "byteSize", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "role": { "enum": ["style", "script", "font", "image", "icon", "other", "speculation-rules"] },
        "mime": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "capabilityId": {
      "enum": [
        "raster_images", "preencoded_video", "scheduled_jobs", "outbound_https",
        "outgoing_email", "ai_drafts", "public_forms"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": { "type": "array", "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/capabilityId" } },
        "optional": { "type": "array", "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/capabilityId" } }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicInteractions", "analytics", "personalData"],
      "properties": {
        "publicInteractions": { "type": "boolean" },
        "analytics": { "enum": ["none", "first_party", "profile_review_required"] },
        "personalData": { "enum": ["none", "editorial_accounts", "public_submissions"] }
      }
    }
  }
}
