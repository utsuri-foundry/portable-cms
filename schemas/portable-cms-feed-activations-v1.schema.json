{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.utsuri.io/portable-cms/feed-activations-v1.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "formatVersion",
        "cursorFloor",
        "activations"
    ],
    "properties": {
        "formatVersion": {
            "const": 1
        },
        "cursorFloor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "activations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "sequence",
                    "releaseId",
                    "path"
                ],
                "properties": {
                    "sequence": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                    },
                    "releaseId": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{32}$"
                    },
                    "path": {
                        "type": "string",
                        "pattern": "^feed/v1/activations/[1-9][0-9]*-[a-f0-9]{32}\\.json$",
                        "maxLength": 500
                    }
                }
            }
        }
    }
}
