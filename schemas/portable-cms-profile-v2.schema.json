{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.utsuri.io/portable-cms/profile-v2.schema.json",
  "title": "Portable CMS profile manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "version",
    "compatibility",
    "locales",
    "defaultLocale",
    "recordTypes",
    "singletons",
    "taxonomyNamespaces",
    "navigation",
    "renderers",
    "assets",
    "capabilities",
    "privacy"
  ],
  "properties": {
    "contentFeed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
            "formatVersion",
            "recordTypes"
        ],
        "properties": {
            "formatVersion": {
                "const": 1
            },
            "recordTypes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "typeId",
                        "fields"
                    ],
                    "properties": {
                        "typeId": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
                            "maxLength": 160
                        },
                        "fields": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 32,
                            "items": {
                                "type": "string",
                                "pattern": "^[a-z][A-Za-z0-9]*(?:[-_][a-z0-9]+)*$",
                                "maxLength": 160
                            },
                            "uniqueItems": true
                        }
                    }
                }
            },
            "pageSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
            }
        }
    },
    "formatVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/canonicalId" },
    "version": { "$ref": "#/$defs/semanticVersion" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/locale" }
    },
    "defaultLocale": { "$ref": "#/$defs/localeId" },
    "recordTypes": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/recordType" }
    },
    "singletons": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/singleton" }
    },
    "taxonomyNamespaces": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/taxonomy" }
    },
    "navigation": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/navigationItem" }
    },
    "renderers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/renderer" }
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/asset" }
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "wording": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/wordingEntry" }
    },
    "languageEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scripts", "directions"],
      "properties": {
        "scripts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Latn"] } },
        "directions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ltr"] } },
        "characters": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9A-F]{4,6}(?:-[0-9A-F]{4,6})?$" } }
